# PostgreSQL (Neon, Supabase ou PostgreSQL standard). Requis pour migrations, imports et API.
DATABASE_URL=
DATABASE_SSL=require

# Active progressivement le catalogue serveur dans le frontend. Sans base configurée,
# ConfigPilot conserve automatiquement son catalogue local et son design actuel.
VITE_COMPONENT_API_ENABLED=false

# BuildCores OpenDB — ODC-By 1.0. Le dépôt peut être remplacé par un checkout local.
BUILDCORES_REPO_URL=https://github.com/buildcores/buildcores-open-db.git
BUILDCORES_REF=main
BUILDCORES_PATH=
COMPONENT_IMPORT_BATCH_SIZE=500

# Open Icecat. L'enrichissement reste désactivé tant que l'abonnement, les droits
# et le mode d'accès exact du compte ne sont pas validés.
ICECAT_ENABLED=false
ICECAT_USERNAME=
ICECAT_API_TOKEN=
ICECAT_LANGUAGE=FR
ICECAT_EXPORT_PATH=
# Ne renseigner qu'avec une URL officiellement fournie pour votre compte Icecat.
ICECAT_CONTENT_URL_TEMPLATE=

# Dataset complémentaire désactivé par défaut : provenance PCPartPicker à valider.
PCPART_DATASET_ENABLED=false
PCPART_DATASET_PATH=
